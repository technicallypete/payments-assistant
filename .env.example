# Payments Assistant: environment template
#
#   cp .env.example .env    # then fill in the four REQUIRED values below
#
# Every compose service loads this file via `env_file: [.env]`. Values that must differ per
# service (mainly DATABASE_URL, which selects the Postgres role) are set in each service's
# `environment:` block in docker-compose.yml and override what's here. Don't set DATABASE_URL here.

# ---------------------------------------------------------------------------
# REQUIRED: external services (see README "Provisioning")
# ---------------------------------------------------------------------------

# Stripe → Developers → API keys (TEST MODE). The app refuses to boot without the sk_test_ prefix.
STRIPE_SECRET_KEY=sk_test_replace_me

# openrouter.ai → Keys. Set a spend limit on the key.
OPENROUTER_API_KEY=sk-or-replace_me

# Telegram @BotFather → /newbot. Username without the leading @.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_BOT_USERNAME=your_payments_bot

# ---------------------------------------------------------------------------
# Stripe webhooks
# ---------------------------------------------------------------------------

# Leave blank: the stripe-cli service writes its signing secret to the shared file below and the
# api reads it from there. Set this only to override (e.g. a dashboard-configured endpoint).
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_FILE=/run/stripe/whsec

# ---------------------------------------------------------------------------
# LLM (LangChain init_chat_model "provider:model" strings)
# ---------------------------------------------------------------------------

LLM_MODEL=openrouter:moonshotai/kimi-k2.6
# Optional override for the daily summary; blank = use LLM_MODEL.
LLM_SUMMARY_MODEL=
LLM_TEMPERATURE=0
LLM_MAX_TOOL_HOPS=6
# Alternatives (see spec §6):
#   openrouter:deepseek/deepseek-v4-pro
#   openrouter:openai/gpt-5.6-luna
#   openrouter:anthropic/claude-sonnet-5.5

# Optional LangSmith tracing for debugging tool loops.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------

# Defines "today", "last week", "next Friday".
BUSINESS_TIMEZONE=America/New_York
DEFAULT_CURRENCY=usd
# Customer payments at or above this (minor units) are handed off to the owner. 200000 = $2,000.00
HANDOFF_THRESHOLD_CENTS=200000

# ---------------------------------------------------------------------------
# Owner account (created by the seed script; no public sign-up)
# ---------------------------------------------------------------------------

OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-please

# ---------------------------------------------------------------------------
# Everything else has a default in docker-compose.yml (ports, DB names/roles, service wiring)
# or in the app's Settings (auth/security tuning). Any of them can still be overridden by
# adding it here: see docs/v0/spec.md §3.4 for the full list and defaults.
# ---------------------------------------------------------------------------
