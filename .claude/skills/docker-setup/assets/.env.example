# ── Project identity (prompted by the skill; these are the only names to set) ──
DB_NAME=myapp            # Postgres database name (also used to derive S3 bucket if you like)
S3_BUCKET=myapp          # MinIO/S3 bucket name

# ── Superuser / migrations ────────────────────────────────────────────────────
DB_ADMIN_USER=admin
DB_ADMIN_PASSWORD=admin

# ── Least-privilege runtime role passwords ────────────────────────────────────
# Roles themselves (web, mcp, reporter, app) are created by postgres/init/01-roles.sql.
WEB_DB_PASSWORD=web
MCP_DB_PASSWORD=mcp

# ── Object storage (MinIO / S3) ───────────────────────────────────────────────
S3_KEY=minio
S3_SECRET=minio123
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# ── Host ports ────────────────────────────────────────────────────────────────
DB_HOST_PORT=5432
API_WEB_HOST_PORT=8000
API_MCP_HOST_PORT=8001
APP_HOST_PORT=3000
