# FastAPI backend: Debian slim + uv. No apt packages: psycopg[binary] ships a prebuilt wheel.
# Do NOT switch to Alpine (musl forces source builds of manylinux wheels).
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:0.9 /uv /uvx /bin/

# The venv lives outside /app so the dev bind mount (./api:/app) never shadows it.
# `uv run` re-syncs it from uv.lock on start, so deps added via `uv add` show up without a rebuild.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/tmp/uv-cache \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Run as the host developer's uid so files written into the bind mount aren't root-owned.
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} app && useradd -m -u ${UID} -g ${GID} app \
 && mkdir -p /opt/venv /app && chown -R app:app /opt/venv /app

USER app
WORKDIR /app

# Dependency layer: cached unless pyproject/lock change
COPY --chown=app:app pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project

COPY --chown=app:app . .
RUN uv sync --frozen

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "payments_assistant.http.app:app", "--host", "0.0.0.0", "--port", "8000"]
